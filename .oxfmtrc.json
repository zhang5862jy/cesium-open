{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "printWidth": 80,
  "trailingComma": "all",
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": false,
  "embeddedLanguageFormatting": "auto",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-ssr/**",
    ".tmp/**",
    "public/**",
    "pnpm-lock.yaml"
  ]
}
