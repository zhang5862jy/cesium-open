{
  "name": "cesium-screen-callout",
  "version": "0.1.0",
  "description": "Unified screen-space target callouts for CesiumJS and OpenLayers",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "development": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "pack": "pnpm pack --pack-destination ./artifacts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "cesium": ">=1.143.0 <2",
    "ol": "^10.11.0"
  },
  "devDependencies": {
    "cesium": "^1.143.0",
    "ol": "^10.11.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "import": "./dist/worker.js"
      }
    }
  },
  "keywords": [
    "cesium",
    "cesiumjs",
    "openlayers",
    "callout",
    "label",
    "webgl"
  ]
}
