{
  "name": "a",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "oxlint . && eslint \"**/*.{vue,html}\"",
    "lint:fix": "oxlint --fix . && eslint --fix \"**/*.{vue,html}\"",
    "lint:strict": "oxlint . --max-warnings=0 && eslint \"**/*.{vue,html}\" --max-warnings=0",
    "lint:html": "eslint \"**/*.html\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev": "vite",
    "build": "pnpm --filter cesium-screen-callout build && pnpm --filter cesium-gauss-kruger-grid build && pnpm --filter opfs-timeseries-store build && vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:gauss-kruger-grid": "pnpm --filter cesium-gauss-kruger-grid build && node scripts/grid-projection-check.mjs && node scripts/grid-geometry-check.mjs",
    "test:target-callout": "pnpm --filter cesium-screen-callout build && node scripts/target-callout-manager-check.mjs && node scripts/target-callout-display-check.mjs && node scripts/target-callout-behavior-check.mjs && node scripts/target-callout-efficiency-check.mjs && node scripts/target-callout-avoidance-check.mjs && node scripts/target-callout-stability-check.mjs",
    "generate:moving-target-data": "node scripts/generate-moving-target-data.mjs",
    "generate:moving-target-lods": "node scripts/generate-moving-target-lods.mjs",
    "verify:moving-target-data": "node scripts/verify-moving-target-data.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "cesium": "^1.143.0",
    "cesium-gauss-kruger-grid": "workspace:*",
    "cesium-screen-callout": "workspace:*",
    "geotiff": "^3.0.5",
    "gsap": "^3.15.0",
    "ol": "^10.11.0",
    "opfs-timeseries-store": "workspace:*",
    "proj4": "^2.19.10",
    "three": "^0.185.1",
    "vue": "^3.5.39",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@html-eslint/eslint-plugin": "0.67.0",
    "@types/node": "^24.13.2",
    "@types/three": "^0.185.1",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.13.0",
    "eslint-plugin-oxlint": "1.89.0",
    "eslint-plugin-vue": "10.11.1",
    "meshoptimizer": "1.2.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-cesium": "^1.2.23",
    "vue-tsc": "^3.3.5"
  }
}
